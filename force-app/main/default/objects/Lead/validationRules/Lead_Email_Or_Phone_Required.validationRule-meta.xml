<?xml version="1.0" encoding="UTF-8"?>
<ValidationRule xmlns="http://soap.sforce.com/2006/04/metadata">
    <fullName>Lead_Email_Or_Phone_Required</fullName>
    <active>true</active>
    <errorConditionFormula>AND(
    ISBLANK( Email ),
    ISBLANK( Phone )
)</errorConditionFormula>
    <errorMessage>Email and phone number must be required</errorMessage>
</ValidationRule>
